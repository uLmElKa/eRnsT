{
	"schemaVersion": 1,
	"id": "ernst",
	"version": "${version}",
	"name": "eRnsT",
	"description": "A shader mod inspired by Mirror's Edge's revolutionary Beast lighting (with almost zero FPS loss) :)",
	"authors": [
		"nazudestiny"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/ernst/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.nazu.ernst.ERnsT"
		],
		"client": [
			"net.nazu.ernst.client.ERnsTClient"
		],
		"modmenu": [ "net.nazu.ernst.client.ERnsTModMenu" ]
	},
	"mixins": [
		"ernst.mixins.json",
		{
			"config": "ernst.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}